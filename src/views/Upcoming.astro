---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { waLink as wl } from "../lib/utils";
import { data, href, langOf, t as tr } from "../lib/i18n";
import { getProjects } from "../lib/projects";

const lang = langOf(Astro.url);
const t = tr(lang);
const up = data("upcoming", lang);
const waLink = (m?: string) => wl(m, lang);
const projects = await getProjects(lang);
const upcoming = projects.filter((p) => p.data.status === "upcoming");
const booking = projects.filter((p) => p.data.status === "booking");
---
<Base title={up.seo_title} description={up.seo_description}>
  <section class="surface relative overflow-hidden py-16 sm:py-24">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[480px] w-[480px] rounded-full bg-brass/20 blur-3xl"></div>
    <div class="container-x relative">
      <nav class="text-[14px] text-on-night-2/60" aria-label="breadcrumb"><a href={href(lang, "/")} class="hover:text-on-night">{t.home}</a> / <span class="text-on-night">{up.eyebrow}</span></nav>
      <span class="eyebrow eyebrow-light mt-6">{up.eyebrow}</span>
      <h1 class="mt-3 text-4xl font-bold text-on-night sm:text-5xl">{up.heading}</h1>
      <p class="mt-5 max-w-2xl text-lg text-on-night-2/80">{up.text}</p>
      <a href={waLink(up.notify_message)} target="_blank" rel="noopener" class="btn-brass mt-8"><Icon name="wa" /> {up.notify_cta}</a>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      {upcoming.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((p, i) => <ProjectCard project={p} eager={i < 3} />)}
        </div>
      ) : (
        <div class="reveal mx-auto max-w-2xl rounded-[2rem] border-2 border-dashed border-brass/50 bg-cream/60 p-10 text-center">
          <span class="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-brass text-ink"><Icon name="building" class="h-8 w-8" /></span>
          <h2 class="mt-6 text-2xl font-bold sm:text-3xl">{up.empty_heading}</h2>
          <p class="lead mt-3">{up.empty_text}</p>
          <a href={waLink(up.notify_message)} target="_blank" rel="noopener" class="btn-wa mt-7"><Icon name="wa" /> {up.notify_cta}</a>
        </div>
      )}
    </div>
  </section>

  {booking.length > 0 && (
    <section class="section bg-cream">
      <div class="container-x">
        <div class="reveal max-w-2xl">
          <span class="eyebrow">{t.booking_now}</span>
          <h2 class="h-section">{up.booking_heading}</h2>
          <p class="lead mt-4">{up.booking_text}</p>
        </div>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {booking.map((p) => <ProjectCard project={p} />)}
        </div>
        <a href={href(lang, "/projects/")} class="btn-outline mt-10">{t.see_all} <Icon name="arrow" /></a>
      </div>
    </section>
  )}
</Base>
