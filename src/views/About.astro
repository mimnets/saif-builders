---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { url, waLink, telLink } from "../lib/utils";
import { data, href, langOf, num, t as tr } from "../lib/i18n";
import { getProjects } from "../lib/projects";

const lang = langOf(Astro.url);
const t = tr(lang);
const site = data("site", lang);
const about = data("about", lang);
const bn = (n: string | number) => num(lang, n);
const projects = await getProjects(lang);
const counts = {
  total: projects.length,
  ready: projects.filter((p) => p.data.status === "ready").length,
  active: projects.filter((p) => ["booking", "ongoing"].includes(p.data.status)).length,
};
const paras = about.story.text.split(/\n\s*\n/).filter(Boolean);
---
<Base title={about.seo_title} description={about.seo_description}>
  <!-- hero -->
  <section class="relative overflow-hidden bg-cream">
    <div class="grain pointer-events-none absolute inset-0 opacity-70"></div>
    <div class="container-x relative grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <nav class="text-[14px] text-ink/60" aria-label="breadcrumb"><a href={href(lang, "/")} class="hover:text-ink">{t.home}</a> / <span class="text-ink">{about.hero.eyebrow}</span></nav>
        <span class="eyebrow mt-6">{about.hero.eyebrow}</span>
        <h1 class="mt-3 text-4xl font-bold !leading-[1.25] sm:text-5xl">{about.hero.title}</h1>
        <p class="lead mt-5 max-w-2xl">{about.hero.text}</p>
        <dl class="mt-8 grid max-w-lg grid-cols-3 gap-3">
          {[[counts.total, t.total_projects], [counts.active, t.active], [counts.ready, t.ready]].map(([n, l]) => (
            <div class="flex flex-col-reverse rounded-2xl bg-white p-4 shadow-soft ring-1 ring-ink/5">
              <dt class="text-[14px] text-ink/65">{l}</dt>
              <dd class="font-display text-3xl font-bold">{bn(n)}{t.pieces}</dd>
            </div>
          ))}
        </dl>
      </div>
      {about.hero.image && (
        <div class="lg:col-span-5">
          <img src={url(about.hero.image)} alt="" width="1600" height="1000" class="aspect-[4/3] w-full rounded-[2rem] object-cover shadow-lift" />
        </div>
      )}
    </div>
  </section>

  <!-- story + mission/vision -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="reveal lg:col-span-6">
        <h2 class="text-3xl font-bold sm:text-4xl">{about.story.heading}</h2>
        <div class="prose-bn mt-5">{paras.map((p) => <p>{p}</p>)}</div>
      </div>
      <div class="grid gap-5 self-start lg:col-span-6">
        <article class="reveal rounded-3xl surface p-8">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brass text-ink"><Icon name="key" class="h-6 w-6" /></span>
          <h2 class="mt-5 text-2xl font-bold text-on-night">{about.mission.heading}</h2>
          <p class="mt-3 text-lg leading-[1.9] text-on-night-2/85">{about.mission.text}</p>
        </article>
        <article class="reveal card p-8">
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-cream text-brass-d"><Icon name="trend" class="h-6 w-6" /></span>
          <h2 class="mt-5 text-2xl font-bold">{about.vision.heading}</h2>
          <p class="mt-3 text-lg leading-[1.9] text-ink/80">{about.vision.text}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- values -->
  <section class="section bg-cream">
    <div class="container-x">
      <h2 class="reveal text-center text-3xl font-bold sm:text-4xl">{about.values.heading}</h2>
      <div class="mt-12 grid auto-rows-fr gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {about.values.items.map((v) => (
          <div class="reveal card flex h-full flex-col p-7">
            <span class="grid h-14 w-14 place-items-center rounded-2xl bg-cream text-brass-d"><Icon name={v.icon} class="h-7 w-7" /></span>
            <h3 class="mt-5 text-xl font-bold">{v.title}</h3>
            <p class="mt-2 leading-[1.85] text-ink/75">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- owner -->
  <section class="section" id="owner">
    <div class="container-x grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="reveal lg:col-span-5">
        <div class="relative mx-auto max-w-sm">
          <div class="absolute -inset-3 -z-10 rotate-3 rounded-[2rem] bg-brass/30"></div>
          {about.owner.photo
            ? <img src={url(about.owner.photo)} alt={site.owner} width="480" height="600" class="aspect-[4/5] w-full rounded-[2rem] object-cover shadow-lift" loading="lazy" />
            : <div class="grid aspect-[4/5] w-full place-items-center rounded-[2rem] bg-ink font-display text-7xl text-brass">{site.owner.slice(-3)}</div>}
        </div>
      </div>
      <div class="reveal lg:col-span-7">
        <span class="eyebrow">{about.owner.eyebrow}</span>
        <svg class="mt-6 h-10 w-10 text-brass" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 7h4v4H8c0 2 1 3 3 3v2c-3 0-5-2-5-5V7zm8 0h4v4h-3c0 2 1 3 3 3v2c-3 0-5-2-5-5V7z"/></svg>
        <blockquote class="mt-3 font-display text-2xl !leading-[1.7] text-ink sm:text-[1.7rem]">{about.owner.message}</blockquote>
        <p class="mt-6 border-t border-ink/10 pt-5"><b class="block font-display text-xl">{site.owner}</b><span class="text-ink/65">{site.owner_title}, {site.name}</span></p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-5 pb-20 sm:px-8">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 rounded-[2rem] surface p-8 sm:flex-row sm:items-center sm:p-12">
      <div><h2 class="text-2xl font-bold text-on-night sm:text-3xl">{t.visit_heading}</h2><p class="mt-2 text-on-night-2/75">{site.address}</p></div>
      <div class="flex flex-wrap gap-3">
        <a href={waLink(t.visit_msg, lang)} target="_blank" rel="noopener" class="btn-brass whitespace-nowrap"><Icon name="wa" /> {t.visit_cta}</a>
        <a href={telLink()} class="btn-ghost-night num whitespace-nowrap"><Icon name="phone" /> {bn(site.phone)}</a>
      </div>
    </div>
  </section>
</Base>
