---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { href, langOf, num, t as tr } from "../lib/i18n";
const lang = langOf(Astro.url);
const t = tr(lang);
---
<Base title={t.nf_title}>
  <section class="section">
    <div class="container-x max-w-2xl text-center">
      <p class="font-display text-7xl font-bold text-brass">{num(lang, 404)}</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{t.nf_h1}</h1>
      <p class="lead mt-4">{t.nf_text}</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={href(lang, "/")} class="btn-ink"><Icon name="home" /> {t.home_page}</a>
        <a href={href(lang, "/projects/")} class="btn-outline">{t.nav.all_projects} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>
