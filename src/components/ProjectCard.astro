---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { bn, url, STATUS } from "../lib/utils";
import { sizeRange } from "../lib/projects";

interface Props { project: CollectionEntry<"projects">; eager?: boolean }
const { project: p, eager = false } = Astro.props;
const d = p.data;
const st = STATUS[d.status];
const r = sizeRange(d.floor_plans);
---
<a href={url(`/projects/${p.id}/`)} class="group card reveal flex h-full flex-col overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-lift" data-status={d.status}>
  <div class="relative aspect-[16/11] overflow-hidden bg-cream">
    <img src={url(d.cover)} alt={`${d.title} এর ছবি`} loading={eager ? "eager" : "lazy"} decoding="async" width="1600" height="1000" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
    <span class:list={["chip absolute left-4 top-4 bg-white/95", st.cls]}>{st.label}</span>
    {d.floors && <span class="chip absolute right-4 top-4 bg-ink/80 text-white backdrop-blur">{bn(d.floors)} তলা</span>}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-bold">{d.title}</h3>
    <p class="mt-1 flex items-center gap-1.5 text-[15px] text-ink/65"><Icon name="pin" class="h-4 w-4 shrink-0" /> {d.location}</p>
    <p class="mt-3 line-clamp-2 text-[15px] leading-7 text-ink/75">{d.tagline}</p>
    <div class="mt-auto flex items-center justify-between border-t border-ink/5 pt-4 [margin-top:max(1.25rem,auto)]">
      <span class="text-[15px] font-semibold text-ink/75">{r ? `${bn(r.min)}–${bn(r.max)} বর্গফুট` : d.bedrooms}</span>
      <span class="grid h-10 w-10 place-items-center rounded-full bg-ink text-cream transition group-hover:bg-brass group-hover:text-ink"><Icon name="arrow" /></span>
    </div>
  </div>
</a>
