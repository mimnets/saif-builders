---
import Icon from "./Icon.astro";
import { url, telLink } from "../lib/utils";
import { data, href, langOf, num, switchPath, t as tr } from "../lib/i18n";

interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const lang = langOf(Astro.url);
const other = lang === "bn" ? "en" : "bn";
const t = tr(lang);
const site = data("site", lang);
const home = href(lang, "/");
const nav = [
  [t.nav.projects, href(lang, "/projects/")],
  [t.nav.upcoming, href(lang, "/upcoming/")],
  [t.nav.about, href(lang, "/about/")],
  [t.nav.offers, home + "#offers"],
  [t.nav.emi, home + "#emi"],
  [t.nav.faq, home + "#faq"],
  [t.nav.contact, home + "#contact"],
];
const here = Astro.url.pathname;
const switchHref = switchPath(here, other);
---
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-cream">{t.skip}</a>
<header id="hdr" class:list={["hdr fixed inset-x-0 top-0 z-50", { "is-solid": !transparent }]} data-transparent={transparent ? "" : undefined}>
  <div class="container-x !px-4 sm:!px-8 flex h-[72px] items-center justify-between gap-2 sm:gap-3">
    <a href={home} class="flex min-w-0 items-center gap-2 sm:gap-3" aria-label={`${site.name} ${t.home_aria}`}>
      <img src={url(site.logo_icon || site.logo)} alt="" class="h-10 w-10 shrink-0 rounded-full sm:h-11 sm:w-11" width="44" height="44" />
      <span class="min-w-0 leading-tight">
        <span class="block whitespace-nowrap font-display text-[15px] font-bold min-[400px]:text-lg sm:text-xl">{site.name}</span>
        <span class="hdr-sub hidden text-[11px] font-medium tracking-[.2em] text-ink/55 min-[400px]:block">{(lang === "en" ? site.tagline_en || site.name_en : site.name_en).toUpperCase()}</span>
      </span>
    </a>
    <nav class="hidden items-center gap-0.5 xl:flex" aria-label={t.nav_main}>
      {nav.map(([label, h]) => <a aria-current={here === h ? "page" : undefined} class="nav-link aria-[current=page]:text-brass-d whitespace-nowrap rounded-full px-3 py-2 text-[15px] font-medium opacity-90 transition hover:bg-ink/5 hover:opacity-100" href={h}>{label}</a>)}
    </nav>
    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <!-- language switch: always visible, high contrast on both the transparent and the solid header -->
      <a href={switchHref} hreflang={other} lang={other} data-lang-switch={other} class="lang-switch" title={t.switch_label} aria-label={t.switch_label}>
        <Icon name="globe" class="h-5 w-5 shrink-0" />
        <span class="font-bold">{t.switch_to}</span>
      </a>
      <a href={telLink()} class="btn-brass hidden !min-h-11 !px-5 !py-2 md:inline-flex"><Icon name="phone" class="h-4 w-4" /> <span class="num">{num(lang, site.phone)}</span></a>
      <button id="menuBtn" class="menu-btn grid h-11 w-10 sm:w-11 place-items-center rounded-full bg-ink/5 xl:hidden" aria-label={t.menu_open} aria-expanded="false" aria-controls="mnav"><Icon name="menu" class="h-6 w-6" /></button>
    </div>
  </div>
</header>

<div id="mnav" class="fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true" aria-label={t.menu}>
  <div class="absolute inset-0 bg-ink/50 backdrop-blur-sm" data-close></div>
  <div class="absolute right-0 top-0 flex h-full w-[86%] max-w-sm flex-col overflow-y-auto bg-paper p-6 shadow-lift">
    <div class="flex items-center justify-between">
      <span class="font-display text-xl font-bold">{t.menu}</span>
      <button class="grid h-11 w-11 place-items-center rounded-full bg-ink/5" data-close aria-label={t.close}><Icon name="x" class="h-6 w-6" /></button>
    </div>
    <a href={switchHref} hreflang={other} lang={other} data-lang-switch={other} class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-brass px-5 py-4 text-lg font-bold text-ink">
      <span class="flex items-center gap-3"><Icon name="globe" class="h-6 w-6" /> {t.switch_to}</span>
      <Icon name="arrow" class="h-5 w-5" />
    </a>
    <nav class="mt-4 flex flex-col gap-1">
      {nav.map(([label, h]) => <a data-close class="rounded-2xl px-4 py-3 text-lg font-medium hover:bg-ink/5" href={h}>{label}</a>)}
    </nav>
    <div class="mt-auto grid gap-3 pt-6">
      <a href={telLink()} class="btn-ink"><Icon name="phone" /> {t.call}</a>
      <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsapp_default)}`} target="_blank" rel="noopener" class="btn-wa"><Icon name="wa" /> {t.whatsapp}</a>
    </div>
  </div>
</div>

<script>
  const hdr = document.getElementById("hdr")!;
  if (hdr.hasAttribute("data-transparent")) {
    const onScroll = () => hdr.classList.toggle("is-solid", window.scrollY > 40);
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
  const m = document.getElementById("mnav")!, mb = document.getElementById("menuBtn")!;
  const close = () => { m.classList.add("hidden"); mb.setAttribute("aria-expanded", "false"); document.body.style.overflow = ""; mb.focus(); };
  mb.addEventListener("click", () => {
    m.classList.remove("hidden"); mb.setAttribute("aria-expanded", "true"); document.body.style.overflow = "hidden";
    (m.querySelector("a") as HTMLElement)?.focus();
  });
  m.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", close));
  addEventListener("keydown", (e) => { if (e.key === "Escape" && !m.classList.contains("hidden")) close(); });
  // keep the visitor on the same section when switching language
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((a) =>
    a.addEventListener("click", () => { if (location.hash) a.href = a.href.split("#")[0] + location.hash; }),
  );
</script>
